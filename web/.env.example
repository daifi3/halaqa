# Copy to .env and adjust.

# true  = demo data, no backend needed (great for exploring the UI)
# false = real backend + LiveKit video
VITE_USE_MOCK=true

# Spring Boot backend. Add this site's address (e.g. http://localhost:5173) to the
# backend's WEB_ORIGINS so the browser is allowed to call it.
VITE_API_URL=http://localhost:3000/api
