# Copy to .env and adjust.

# true  = demo data, no backend needed (great for exploring the UI)
# false = real backend + LiveKit video
EXPO_PUBLIC_USE_MOCK=false

# Spring Boot backend. From an Android emulator the host machine is 10.0.2.2;
# from a real phone use your computer's LAN IP, e.g. http://192.168.1.20:3000/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api
